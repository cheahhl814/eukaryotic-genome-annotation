// ─── conf/test.config — resource overrides for the -profile test stub-run ──
//
// Loaded via includeConfig from profiles.test in nextflow.config. Keeps the
// CI DAG buildable on modest machines (the default labels target real HPC runs).
// Fixtures come from the skill root's test-data/ (see test-data/MANIFEST.tsv);
// run the test command from the SKILL ROOT:
//   nextflow run runners/nextflow-runner/main.nf -profile test -stub-run

process {
    errorStrategy = 'terminate'
    withLabel: 'process_single' { cpus = 1; memory = 2.GB; time = 15.m }
    withLabel: 'process_low'    { cpus = 2; memory = 3.GB; time = 15.m }
    withLabel: 'process_medium' { cpus = 2; memory = 4.GB; time = 15.m }
    withLabel: 'process_high'   { cpus = 2; memory = 4.GB; time = 15.m }
    withLabel: 'process_long'   { cpus = 2; memory = 4.GB; time = 15.m }
    withLabel: 'process_huge'   { cpus = 2; memory = 4.GB; time = 15.m }
}