// ─── Genome Annotation Pipeline — Configuration ────────────────────────────
//
// All parameters, profiles, and resource labels.
// No logic here. Only params, profiles, and resources.
// See workflow/SKILL.md for parameter descriptions and when to use each mode.

// ─── Parameters ─────────────────────────────────────────────────────────────

params {
    // Required
    genome          = null              // Path to genome assembly FASTA
    mode            = 'braker3'          // braker3 | braker3_protein | braker3_rnaseq | galba | funannotate
    species         = 'unknown_species'  // Species name for AUGUSTUS/Funannotate

    // Gene prediction inputs
    orthodb         = null              // Path to OrthoDB clade partition (BRAKER3 modes)
    prot_seq        = null              // Path to close-relative proteomes (GALBA mode)
    rnaseq          = null              // Glob pattern for RNA-seq reads (paired-end)

    // Phase control
    skip_repeat     = false             // Skip repeat masking (provide --genome_masked)
    skip_ncrna      = false             // Skip ncRNA annotation
    skip_functional = false             // Skip functional annotation
    skip_qc         = false             // Skip final QC (run manually for interpretation)

    // Pre-computed inputs (skip earlier phases)
    genome_masked   = null              // Pre-masked genome (skip Phase 1)
    braker_gff      = null              // Pre-computed gene models (skip Phase 2)
    proteins        = null              // Pre-computed proteins (for functional annotation only)

    // ncRNA parameters
    ncrna_domain    = 'euk'             // Domain for tRNAscan-SE: euk | bac | arc | G
    rfam_cm         = null              // Path to Rfam.cm covariance model database
    rfam_clanin     = null              // Path to Rfam.clanin clan competition file

    // BUSCO/compleasm lineage
    busco_lineage   = 'vertebrata_odb12'  // BUSCO lineage dataset

    // Functional annotation databases
    eggnog_db       = null              // Path to eggNOG database directory

    // Output
    outdir          = 'results'
}

// Parameter validation is handled in main.nf (Nextflow config does not support error())

// ─── Profiles ────────────────────────────────────────────────────────────────


// ─── Resource Labels (nf-core style) ────────────────────────────────────────

process {
    withLabel: 'process_single' {
        cpus   = 1
        memory = 6.GB
        time   = 4.h
    }
    withLabel: 'process_low' {
        cpus   = 2
        memory = 12.GB
        time   = 8.h
    }
    withLabel: 'process_medium' {
        cpus   = 8
        memory = 36.GB
        time   = 24.h
    }
    withLabel: 'process_high' {
        cpus   = 16
        memory = 72.GB
        time   = 48.h
    }
    withLabel: 'process_long' {
        cpus   = 16
        memory = 72.GB
        time   = 96.h
    }
    withLabel: 'process_huge' {
        cpus   = 32
        memory = 128.GB
        time   = 120.h
    }

    // Memory-heavy retry strategy
    errorStrategy = 'retry'
    maxRetries    = 3
}

// ─── Trace and Reporting ────────────────────────────────────────────────────

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
}

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
}

dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag.html"
}
trace.overwrite = true
report.overwrite = true
timeline.overwrite = true
profiles {
    standard {
        process.executor = 'local'
    }

    slurm {
        process.executor  = 'slurm'
        process.queue     = 'normal'
        process.clusterOptions = '--account=bioinformatics'
    }

    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    conda {
        conda.enabled = true
        conda.useMamba = true
    }

    test {
        // Deterministic fixtures from the skill's test-data/ (generate with:
        //   python3 test-data/make_fixtures.py — see test-data/MANIFEST.tsv).
        // Anchored on launchDir: run the test command from the SKILL ROOT,
        //   nextflow run runners/nextflow-runner/main.nf -profile test -stub-run
        params.genome   = "${launchDir}/test-data/ref.fasta"
        params.mode     = 'funannotate'   // genome-only mode — no orthodb/proteome fixture needed
        params.species  = 'Test_species'
        includeConfig 'conf/test.config'
    }
}
